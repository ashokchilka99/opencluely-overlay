{
  "name": "opencluely-overlay",
  "version": "2.1.0",
  "description": "Persistent desktop overlay for text and image questions with Claude and Gemini",
  "main": "overlay/main.js",
  "author": "OpenCluely contributors",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ashokchilka99/opencluely-overlay.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node scripts/launch.js",
    "dev": "node scripts/launch.js",
    "test": "node --test tests/core.test.js tests/providers.test.js tests/storage.test.js",
    "test:desktop": "node scripts/launch.js --smoke-test",
    "icons": "node scripts/create-icons.js",
    "postinstall": "node scripts/create-icons.js",
    "build": "electron-builder",
    "build:win": "electron-builder --win nsis portable --x64",
    "pack": "electron-builder --dir"
  },
  "dependencies": {
    "dompurify": "3.4.17",
    "marked": "18.1.1"
  },
  "overrides": {
    "global-agent": "4.1.3"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.opencluely.overlay",
    "productName": "OpenCluely Overlay",
    "directories": {
      "output": "dist"
    },
    "files": [
      "overlay/**/*",
      "package.json",
      "LICENSE",
      "NOTICE",
      "!**/*.map"
    ],
    "asar": true,
    "win": {
      "icon": "overlay/assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "OpenCluely-Overlay-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "OpenCluely-Overlay-Portable-${version}.${ext}"
    }
  }
}
